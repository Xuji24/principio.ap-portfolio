EMAIL_USER=
EMAIL_PASS=
CONTACT_TO=principio.ap@gmail.com
NEXT_PUBLIC_WEBSITE_NAME=Portfolio

# Required on every route — app/(dashboard)/layout.tsx calls lib/supabase/server.ts
# on every request, which reads these with non-null assertions and crashes if unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used by app/api/chat/route.ts (the portfolio chat assistant).
# SITE_URL restricts which origins may call /api/chat; falls back to the Vercel-provided
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL in deployed environments, then localhost:3000.
SITE_URL=
# At least one provider API key is needed for the chat assistant to return a real reply;
# providers are tried in order (Groq, then OpenRouter, then OpenCode Zen) and each is
# skipped if its key is unset. The *_MODEL vars are optional overrides with defaults.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
